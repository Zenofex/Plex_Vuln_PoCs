FROM plexinc/pms-docker@sha256:dd9bcf6494a1f7e817710e75d2ff66beb68485b5ea1b63c7c712adc25983b9bb

ARG PMS_PACKAGE
ARG PMS_VERSION
COPY ${PMS_PACKAGE} /tmp/plexmediaserver.deb
RUN dpkg -i /tmp/plexmediaserver.deb \
    && sed -i "s/^version=.*/version=${PMS_VERSION}/" /version.txt \
    && rm /tmp/plexmediaserver.deb
